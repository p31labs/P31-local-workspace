---
/**
 * PersonaSwitcher.astro — PHOS Bros Phase Component
 * Dynamic persona selector. Zero hardcoded identity.
 */

interface Props {
  personas: Array<{ id: string; config: PersonaConfig }>;
  currentPersona: string;
  onSwitch?: (personaId: string) => void;
}

interface PersonaConfig {
  id: string;
  name: string;
  mode: string;
  color?: string;
  icon?: string;
  relationshipType?: string;
}

const { personas = [], currentPersona = '', onSwitch } = Astro.props;
---

<div
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"
  role="radiogroup"
  aria-label="Persona selector"
  data-persona-switcher
>
  {personas.map(({ id, config }) => {
    const active = id === currentPersona;
    const color = config.color || '#888888';
    const label = `${config.name} — ${config.mode} mode`;
    const relationship = config.relationshipType
      ? ` (${config.relationshipType})`
      : '';

    return (
      <button
        type="button"
        role="radio"
        aria-checked={active ? 'true' : 'false'}
        aria-label={`${label}${relationship}`}
        data-persona={id}
        data-active={active ? 'true' : 'false'}
        class={[
          'relative flex items-center gap-3 p-3 rounded-xl border transition-all duration-200',
          'focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-zinc-900',
          active
            ? 'border-current bg-zinc-800/80 opacity-100 focus:ring-offset-2'
            : 'border-zinc-700 bg-zinc-900/60 opacity-70 hover:opacity-100',
          `focus:ring-[${color}]`
        ].join(' ')}
        style={active ? `--persona-color: ${color}; border-color: ${color}40;` : ''}
      >
        <span class="text-2xl flex-shrink-0" aria-hidden="true">
          {config.icon || '👤'}
        </span>
        <span class="flex flex-col items-start">
          <span class="font-medium text-sm">{config.name}</span>
          <span class="text-xs text-zinc-400">{config.mode}</span>
        </span>
        {active && (
          <span
            class="absolute top-2 right-2 w-5 h-5 rounded-full flex items-center justify-center"
            style={`background: ${color};`}
            aria-hidden="true"
          >
            <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </span>
        )}
        <span class="sr-only">{relationship}</span>
      </button>
    );
  })}
</div>

<script>
  (function() {
    const container = document.querySelector('[data-persona-switcher]');
    if (!container) return;

    const buttons = Array.from(container.querySelectorAll('[data-persona]'));
    if (buttons.length === 0) return;

    function setActive(btn: HTMLElement) {
      buttons.forEach(b => {
        b.setAttribute('data-active', 'false');
        b.setAttribute('aria-checked', 'false');
        b.classList.remove('opacity-100');
        b.classList.add('opacity-70');
      });
      btn.setAttribute('data-active', 'true');
      btn.setAttribute('aria-checked', 'true');
      btn.classList.remove('opacity-70');
      btn.classList.add('opacity-100');
    }

    function select(btn: HTMLElement) {
      const persona = btn.getAttribute('data-persona');
      if (!persona) return;
      setActive(btn);
      window.dispatchEvent(new CustomEvent('bros.persona.changed', {
        detail: { persona }
      }));
      if (typeof (window as any).__personaSwitchCallback === 'function') {
        (window as any).__personaSwitchCallback(persona);
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => select(btn as HTMLElement));
    });

    container.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = document.activeElement as HTMLElement | null;
      if (!current || !current.hasAttribute('data-persona')) return;
      const idx = buttons.indexOf(current);
      if (idx === -1) return;

      let next = -1;
      if ((e as any).key === 'ArrowRight' || (e as any).key === 'ArrowDown') {
        next = (idx + 1) % buttons.length;
      } else if ((e as any).key === 'ArrowLeft' || (e as any).key === 'ArrowUp') {
        next = (idx - 1 + buttons.length) % buttons.length;
      } else if ((e as any).key === 'Enter' || (e as any).key === ' ') {
        e.preventDefault();
        select(current);
        return;
      }

      if (next >= 0) {
        e.preventDefault();
        buttons[next].focus();
      }
    });
  })();
</script>
