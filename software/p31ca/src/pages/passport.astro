---
import AppShell from '../layouts/AppShell.astro';
import { PassportPage } from '../passport/pages/PassportPage';
---

<AppShell
  title="P31 Cognitive Passport — Build Your Identity Profile"
  description="Create, manage, and export your P31 Cognitive Passport — your identity across the ecosystem."
  routeName="passport"
>
  <main class="min-h-screen bg-zinc-950 text-zinc-100">
    <div class="max-w-3xl mx-auto px-4 py-12">
      <header class="mb-8">
        <h1 class="text-2xl font-bold text-teal-400">Cognitive Passport</h1>
        <p class="text-sm text-zinc-400 mt-1">
          Your identity profile across the P31 ecosystem. All data stays on your device until you choose to export.
        </p>
      </header>
      <PassportPage client:load />
    </div>
  </main>
</AppShell>
