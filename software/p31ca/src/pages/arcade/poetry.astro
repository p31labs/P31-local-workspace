---
// Magnetic Poetry — Native game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { MagneticPoetryShell } from '../../components/games/magnetic-poetry/MagneticPoetryShell.tsx';
---

<ArcadeShell
  gameId="poetry"
  gameTitle="Magnetic Poetry"
  gameIcon="🧲"
  showSelector={false}
  fullscreen
>
  <div class="poetry-mount">
    <MagneticPoetryShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0f1115; }
    .poetry-mount {
      padding-top: 52px;
      min-height: calc(100vh - 52px);
    }
  </style>
</ArcadeShell>
