---
// Strategy Board — Classic game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
---

<ArcadeShell
  gameId="strategy"
  gameTitle="Strategy Board"
  gameIcon="♟️"
  showSelector={false}
  fullscreen
>
  <div class="classic-game-mount" data-game="strategy">
    <div class="classic-game-frame">
      <div class="classic-game-placeholder" style="--game-accent: #cda852;">
        <div class="placeholder-icon">♟️</div>
        <h2 class="placeholder-title">STRATEGY BOARD</h2>
        <p class="placeholder-desc">Turn-based tactical warfare with pathfinding AI</p>
        <div class="placeholder-actions">
          <a
            id="play-link"
            href="https://p31-strategy.pages.dev"
            class="classic-play-btn"
            target="_blank"
            rel="noopener"
            style="--btn-color: #cda852;"
          >
            ▶ PLAY NOW
          </a>
          <button class="classic-score-btn" id="view-scores">🏆 HIGH SCORES</button>
        </div>
        <div class="placeholder-instructions">
          <h3>How to Play</h3>
          <ul>
            <li>Turn-based tactics</li>
            <li>Unit positioning matters</li>
            <li>Terrain affects combat</li>
            <li>Supply lines critical</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="classic-hud">
      <span class="classic-hud-label">PATHFINDING AI ACTIVE</span>
      <span class="classic-hud-spoons" id="hud-spoons">🥄 4/12</span>
    </div>
  </div>

  <script is:inline>
    (function() {
      'use strict';
      const SPOON_COLORS = {0:'#cc6247',1:'#cc6247',2:'#cda852',3:'#cda852',4:'#cda852',5:'#cda852',6:'#cda852',7:'#cda852',8:'#3ba372',9:'#3ba372',10:'#3ba372',11:'#3ba372',12:'#3ba372'};

      // Update high score button
      const scoresBtn = document.getElementById('view-scores');
      if (scoresBtn) {
        scoresBtn.addEventListener('click', async () => {
          try {
            const db = await import('../../lib/arcade-core/pglite/client.ts');
            const result = await (await db.getPGlite()).query(
              `SELECT s.score, s.created_at, p.name
               FROM arcade_high_scores s
               JOIN arcade_players p ON s.player_id = p.id
               WHERE s.game_id = (SELECT id FROM arcade_games WHERE slug = 'strategy')
               ORDER BY s.score DESC LIMIT 10`
            );
            const rows = result.rows;
            alert(rows.length === 0 ? 'No scores yet! Play to set a record.' : 'High Scores:\n' + rows.map((r, i) => `${i + 1}. ${r.score} - ${r.name}`).join('\n'));
          } catch {
            const scores = JSON.parse(localStorage.getItem('p31-arcade-highscores') || '{}');
            const strategy = scores.strategy || [];
            alert('High Scores:\n' + (strategy.length > 0 ? strategy.map((s, i) => `${i + 1}. ${s.score.toLocaleString()} - ${s.date}`).join('\n') : 'No scores yet!'));
          }
        };
      }

      // Update play link href when spoon level changes
      const playLink = document.getElementById('play-link');
      const hudSpoons = document.getElementById('hud-spoons');
      function updatePlayLink(level) {
        const lvl = Math.max(0, Math.min(12, level));
        playLink.href = `https://p31-strategy.pages.dev?spoon=${lvl}`;
        hudSpoons.textContent = '🥄 ' + lvl + '/12';
        hudSpoons.style.color = SPOON_COLORS[lvl] || '#cda852';
      }
      // Initial call with default level 4
      updatePlayLink(4);
      // Listen for spoon changes
      window.addEventListener('p31:spoon:changed', (e) => {
        if (e.detail?.level !== undefined) {
          updatePlayLink(e.detail.level);
        }
      });
    })();
  </script>

  <style is:inline>
    :global(body) { background: #0f1115; overflow: hidden; }
    .classic-game-mount { position: fixed; inset: 0; display: flex; flex-direction: column; }
    .classic-game-frame { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; margin-top: 52px; }
    .classic-game-placeholder { max-width: 520px; width: 100%; text-align: center; padding: 48px 32px; background: rgba(255,255,255,0.03); border: 2px solid rgba(205,168,82,0.2); border-radius: 20px; }
    .placeholder-icon { font-size: 72px; line-height: 1; margin-bottom: 20px; }
    .placeholder-title { font-family: 'Press Start 2P', cursive; font-size: 20px; color: #cda852; margin: 0 0 16px; letter-spacing: 0.1em; }
    .placeholder-desc { font-size: 15px; color: rgba(232,230,227,0.65); margin: 0 0 32px; font-family: 'JetBrains Mono', monospace; line-height: 1.5; }
    .placeholder-actions { display: flex; flex-direction: column; gap: 12px; margin-bottom: 36px; }
    .classic-play-btn { display: flex; align-items: center; justify-center; gap: 12px; padding: 20px 40px; background: var(--btn-color, #cda852); color: #0f1115; text-decoration: none; border-radius: 12px; font-family: 'Press Start 2P', cursive; font-size: 13px; font-weight: 700; transition: all 0.25s; box-shadow: 0 8px 28px rgba(205,168,82,0.3); }
    .classic-play-btn:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 14px 36px rgba(205,168,82,0.5); }
    .classic-score-btn { padding: 16px 32px; background: transparent; border: 2px solid rgba(139,124,201,0.4); border-radius: 12px; color: #8b7cc9; font-family: 'Press Start 2P', cursive; font-size: 10px; font-weight: 700; cursor: pointer; transition: all 0.25s; }
    .classic-score-btn:hover { background: rgba(139,124,201,0.08); border-color: #8b7cc9; }
    .placeholder-instructions { text-align: left; padding: 24px; background: rgba(255,255,255,0.03); border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); }
    .placeholder-instructions h3 { font-family: 'Press Start 2P', cursive; font-size: 9px; color: #cda852; margin: 0 0 16px; }
    .placeholder-instructions ul { margin: 0; padding-left: 20px; color: rgba(232,230,227,0.65); font-size: 14px; line-height: 1.8; }
    .classic-hud { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 14px; padding: 8px 18px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08); border-radius: 99px; z-index: 20; backdrop-filter: blur(6px); }
    .classic-hud-label { font-size: 9px; font-family: 'JetBrains Mono', monospace; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(232,230,227,0.4); }
    .classic-hud-spoons { font-size: 13px; color: #cda852; transition: color 0.4s; }
    @media (max-width: 600px) { .classic-game-placeholder { padding: 32px 20px; } .placeholder-icon { font-size: 52px; } .placeholder-title { font-size: 15px; } .classic-play-btn { padding: 16px 28px; font-size: 11px; } }
  </style>
</ArcadeShell>
