    "@react-three/postprocessing": "^2.19.1",
    "@types/d3-force": "^3.0.10",
    "astro": "^5.17.1",
    "d3-force": "^3.0.0",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.170.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30"
