# P31 Labs — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ─── Cloudflare ────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=
AXIOM_API_TOKEN=
AXIOM_DATASET=p31-workers

# ─── LOVE Ledger ───────────────────────────────────────────────────────
LOVE_LEDGER_URL=https://love-ledger.p31ca.org
# On-chain attestation bridge (CWP-2026-022). love-ledger anchors every
# court-admissible entry here; agents can anchor via the love_anchor MCP tool.
BRIDGE_URL=https://ledger-bridge.trimtab-signal.workers.dev
LEDGER_BRIDGE_URL=https://ledger-bridge.trimtab-signal.workers.dev

# ─── LLM Providers ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Blockchain / Taler ───────────────────────────────────────────────
SEPOLIA_RPC_URL=
TALER_EXCHANGE_URL=https://exchange.demo.taler.net

# ─── Auth ──────────────────────────────────────────────────────────────
P31_USER_ID=guest

# ─── CI / GitHub Actions ──────────────────────────────────────────────
# Add to repo Settings → Secrets → Actions:
# CLOUDFLARE_API_TOKEN, SENTRY_DSN
