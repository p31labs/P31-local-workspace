---
// Bashball — Classic arcade route (native simulation)
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { BashballGameShell } from '../../components/games/BashballGameShell.tsx';
---

<ArcadeShell
  gameId="bashball"
  gameTitle="Bashball"
  gameIcon="⚾"
  showSelector={false}
  fullscreen
>
  <div class="bashball-mount">
    <BashballGameShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0f1115; overflow: hidden; margin: 0; }
    .bashball-mount {
      position: fixed;
      inset: 0;
      overflow-y: auto;
      z-index: 1;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(204,98,71,0.2); border-radius: 3px; }
  </style>
</ArcadeShell>
