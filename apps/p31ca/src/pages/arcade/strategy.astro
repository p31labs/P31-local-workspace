---
// Strategy Board — Native game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { StrategyBoardGameShell } from '../../components/games/strategy-board/StrategyBoardGameShell.tsx';
---

<ArcadeShell
  gameId="strategy"
  gameTitle="Strategy Board"
  gameIcon="♟️"
  showSelector={false}
  fullscreen
>
  <div class="strategy-mount">
    <StrategyBoardGameShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0A0A0F; }
    .strategy-mount {
      padding-top: 52px;
      min-height: calc(100vh - 52px);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  </style>
</ArcadeShell>
