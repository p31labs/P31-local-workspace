---
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { CardTableGame } from '../../components/games/CardTableGame.tsx';
---

<ArcadeShell
  gameId="cards"
  gameTitle="Card Table"
  gameIcon="🃏"
  showSelector={false}
  fullscreen
>
  <div class="card-table-mount">
    <CardTableGame client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0f1115; overflow: hidden; margin: 0; }
    .card-table-mount {
      position: fixed;
      inset: 0;
      overflow-y: auto;
      z-index: 1;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(139,124,201,0.2); border-radius: 3px; }
  </style>
</ArcadeShell>
