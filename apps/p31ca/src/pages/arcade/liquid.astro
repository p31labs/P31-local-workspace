---
// Liquid Sculptor — Native game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { LiquidSculptorShell } from '../../components/games/liquid-sculptor/LiquidSculptorShell.tsx';
---

<ArcadeShell
  gameId="liquid"
  gameTitle="Liquid Sculptor"
  gameIcon="💧"
  showSelector={false}
  fullscreen
>
  <div class="liquid-mount">
    <LiquidSculptorShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0A0A0F; }
    .liquid-mount {
      padding-top: 52px;
      min-height: calc(100vh - 52px);
    }
  </style>
</ArcadeShell>
