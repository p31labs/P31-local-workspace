---
// Resonance Rings — Native game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { ResonanceRingsShell } from '../../components/games/resonance-rings/ResonanceRingsShell.tsx';
---

<ArcadeShell
  gameId="resonance"
  gameTitle="Resonance Rings"
  gameIcon="🌊"
  showSelector={false}
  fullscreen
>
  <div class="resonance-mount">
    <ResonanceRingsShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0A0A0F; }
    .resonance-mount {
      padding-top: 52px;
      min-height: calc(100vh - 52px);
    }
  </style>
</ArcadeShell>
