---
// Orbital Drift — Native game route
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { OrbitalDriftShell } from '../../components/games/orbital-drift/OrbitalDriftShell.tsx';
---

<ArcadeShell
  gameId="orbital"
  gameTitle="Orbital Drift"
  gameIcon="🪐"
  showSelector={false}
  fullscreen
>
  <div class="orbital-mount">
    <OrbitalDriftShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0f1115; }
    .orbital-mount {
      padding-top: 52px;
      min-height: calc(100vh - 52px);
    }
  </style>
</ArcadeShell>
