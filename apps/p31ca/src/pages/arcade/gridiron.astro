---
// Gridiron — Classic arcade route (native football simulation)
import ArcadeShell from '../../layouts/ArcadeShell.astro';
import { GridironGameShell } from '../../components/games/GridironGameShell.tsx';
---

<ArcadeShell
  gameId="gridiron"
  gameTitle="Gridiron"
  gameIcon="🏈"
  showSelector={false}
  fullscreen
>
  <div class="gridiron-mount">
    <GridironGameShell client:load />
  </div>

  <style is:inline>
    :global(body) { background: #0f1115; overflow: hidden; margin: 0; }
    .gridiron-mount {
      position: fixed;
      inset: 0;
      overflow-y: auto;
      z-index: 1;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(59,163,114,0.2); border-radius: 3px; }
  </style>
</ArcadeShell>
