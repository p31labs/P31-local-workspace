---
import MarketingShell from '../layouts/MarketingShell.astro';
import MarketingTopbar from '../components/marketing/MarketingTopbar.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import ResearchCard from '../components/marketing/ResearchCard.astro';
import Footer from '../components/marketing/Footer.astro';
import { papers } from '../data/p31-research.ts';
---

<MarketingShell title="Research — P31 Labs" description="22 papers on Zenodo. Citable, immutable, open. From SIC-POVM to Posner molecules.">
  <MarketingTopbar slot="starfield" />
  
  <main id="main-content" class="section">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader title="Research" description="22 papers published on Zenodo. Citable, immutable, open. From SIC-POVM to Posner molecules." />
      
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {papers.map((paper) => (
          <ResearchCard {...paper} />
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
