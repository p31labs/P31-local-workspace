---
import MarketingShell from '../layouts/MarketingShell.astro';
import MarketingTopbar from '../components/marketing/MarketingTopbar.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
---

<MarketingShell title="About — P31 Labs" description="Mission, founder, and 501(c)(3) story of P31 Labs — sovereign stack for neurodivergent families.">
  <MarketingTopbar slot="starfield" />
  
  <main id="main-content" class="section">
    <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader title="About" description="Sovereign infrastructure for neurodivergent families, built by a father who needed it." align="left" />
      
      <div class="mt-16 space-y-8 animate-fade-in-up delay-200">
        <div class="glass-card">
          <div class="p-8 space-y-6">
            <h3 class="text-2xl font-bold" style="color: var(--p31-text);">Mission</h3>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              P31 Labs exists to give neurodivergent families sovereign control over their data, identity, and care infrastructure. We believe that assistive technology should not be extractive, surveillance-based, or locked behind corporate walls.
            </p>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              Our stack — 12 Cloudflare Workers, 10 D1 databases, 16 Durable Objects, 36 MCP tools — runs on the world's largest edge network. Zero server costs. Open source. Citable on Zenodo.
            </p>
          </div>
        </div>

        <div class="glass-card">
          <div class="p-8 space-y-6">
            <h3 class="text-2xl font-bold" style="color: var(--p31-text);">Founder</h3>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              Patrick is a software engineer and parent navigating the intersection of neurodivergence, care infrastructure, and sovereign technology. P31 Labs grew from a personal need into an open-source stack that anyone can deploy.
            </p>
          </div>
        </div>

        <div class="glass-card">
          <div class="p-8 space-y-6">
            <h3 class="text-2xl font-bold" style="color: var(--p31-text);">501(c)(3) Status</h3>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              P31 Labs is organized as a 501(c)(3) nonprofit. Donations are tax-deductible to the fullest extent of the law. Our research is published on Zenodo under open licenses. Our code is on GitHub under AGPL.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
