---
import AppShell from '../layouts/AppShell.astro';
---

<AppShell title="P31 Labs | 404 Not Found" routeName="404">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <p class="text-[10px] font-mono tracking-[0.2em] uppercase mb-3" style="color:var(--p31-accent-red,#f43f5e)">Error 404</p>
    <h1 class="text-8xl font-bold mb-4" style="color:var(--p31-accent-red,#f43f5e)">404</h1>
    <p class="text-xl mb-10" style="color:var(--p31-text-primary,#F5F5F7)">This page doesn't exist. Here are some that do:</p>
    <div class="flex flex-wrap gap-3 mb-8">
      <a href="/" class="px-6 py-3 rounded-xl font-bold transition-all"
        style="background:rgba(0,240,255,0.12);border:1px solid rgba(0,240,255,0.3);color:var(--p31-accent,#00F0FF)">
        Home
      </a>
      <a href="/demos" class="px-6 py-3 rounded-xl font-bold transition-all"
        style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--p31-text-primary,#F5F5F7)">
        Demos
      </a>
      <a href="/about" class="px-6 py-3 rounded-xl font-bold transition-all"
        style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--p31-text-primary,#F5F5F7)">
        About
      </a>
      <a href="/research" class="px-6 py-3 rounded-xl font-bold transition-all"
        style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--p31-text-primary,#F5F5F7)">
        Research
      </a>
      <a href="/connect" class="px-6 py-3 rounded-xl font-bold transition-all"
        style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--p31-text-primary,#F5F5F7)">
        Mesh
      </a>
    </div>
  </div>
</AppShell>
