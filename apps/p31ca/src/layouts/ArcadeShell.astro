---
/**
 * ArcadeShell.astro — Dedicated housing for all P31 Arcade games
 *
 * Now unified with arcade-core: shared registry, spoon gauge, event bus.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SPOON_LEVEL_COLORS, COLORS, ARCADE_GAMES } from '../lib/arcade-core/theme.ts';
import { SpoonSync } from '../components/games/spoon-sync.tsx';

interface Props {
  title?: string;
  description?: string;
  gameId: string;
  gameTitle: string;
  gameIcon?: string;
  showSelector?: boolean;
  fullscreen?: boolean;
}

const {
  title = 'P31 Arcade',
  description = 'A neuro-adaptive sandbox for cognitive regulation',
  gameId,
  gameTitle,
  gameIcon = '🎮',
  showSelector = true,
  fullscreen = false,
} = Astro.props;

const arcadeGames = ARCADE_GAMES;
const currentGame = arcadeGames.find(g => g.id === gameId) || ARCADE_GAMES[0];

// Initial spoon level for HTML hydration
const initialSpoonLevel = 4;
const initialSpoonColor = SPOON_LEVEL_COLORS[initialSpoonLevel] ?? COLORS.teal;
---

<!doctype html>
<html lang="en" class="dark" data-p31-appearance="hub" data-arcade-game={gameId} style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={COLORS.void} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/p31-192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="/p31-style.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>{gameTitle} | P31 Arcade</title>

    <ClientRouter />

    <!-- Theme Engine (load order is load-bearing) -->
    <script type="module" src="/lib/p31-theme-engine.mjs"></script>
    <script type="module" src="/lib/p31-theme-switcher.mjs"></script>

    <style is:inline>
      :root {
        /* ===== Theme Engine base tokens (fallbacks; p31-theme-engine.mjs overrides via inline style) ===== */
        --p31-coral: #{COLORS.rust};
        --p31-butter: #{COLORS.gold};
        --p31-lavender: #{COLORS.purple};
        --p31-phosphorus: #{COLORS.green};
        --p31-cyan: #{COLORS.teal};
        --p31-phosphor: #00ff88;
        --p31-surface: #{COLORS.voidLighter};
        --p31-surface2: #1c2028;
        --p31-surface3: #232830;
        --p31-paper: #f4f4f5;
        --p31-ink: #1e293b;
        --p31-muted: #6b7280;

        /* ===== Arcade game colors — aliased to Theme Engine tokens for runtime switching ===== */
        --p31-void: #{COLORS.void};
        --p31-void-lighter: #{COLORS.voidLighter};
        --p31-deep-void: #{COLORS.deepVoid};
        --p31-cloud: #{COLORS.cloud};
        --p31-cloud-70: #{COLORS.cloud70};
        --p31-cloud-60: #{COLORS.cloud60};
        --p31-cloud-50: #{COLORS.cloud50};
        --p31-cloud-40: #{COLORS.cloud40};
        --p31-cloud-35: #{COLORS.cloud35};
        --p31-cloud-30: #{COLORS.cloud30};
        --p31-cloud-25: #{COLORS.cloud25};
        --p31-cloud-20: #{COLORS.cloud20};
        --p31-white-15: #{COLORS.white15};
        --p31-white-12: #{COLORS.white12};
        --p31-white-10: #{COLORS.white10};
        --p31-white-8: #{COLORS.white8};
        --p31-white-6: #{COLORS.white6};
        --p31-white-5: #{COLORS.white5};
        --p31-white-4: #{COLORS.white4};
        --p31-white-3: #{COLORS.white3};
        --p31-white-2: #{COLORS.white2};
        --p31-teal: var(--p31-cyan);
        --p31-teal-dim: color-mix(in srgb, var(--p31-teal) 30%, transparent);
        --p31-gold: var(--p31-butter);
        --p31-gold-dim: color-mix(in srgb, var(--p31-gold) 15%, transparent);
        --p31-gold-border: color-mix(in srgb, var(--p31-gold) 25%, transparent);
        --p31-rust: var(--p31-coral);
        --p31-rust-dim: color-mix(in srgb, var(--p31-rust) 12%, transparent);
        --p31-rust-border: color-mix(in srgb, var(--p31-rust) 20%, transparent);
        --p31-purple: var(--p31-lavender);
        --p31-purple-dim: color-mix(in srgb, var(--p31-purple) 15%, transparent);
        --p31-purple-border: color-mix(in srgb, var(--p31-purple) 20%, transparent);
        --p31-green: var(--p31-phosphorus);
        --p31-green-dim: color-mix(in srgb, var(--p31-green) 15%, transparent);
        --p31-green-border: color-mix(in srgb, var(--p31-green) 30%, transparent);
        --p31-ice: var(--p31-cyan);
        --p31-card-red: #{COLORS.cardRed};
        --p31-field-green: #{COLORS.fieldGreen};
      }

      html {
        font-family: 'JetBrains Mono', system-ui, sans-serif;
        background: var(--p31-void);
        color: var(--p31-cloud-70);
      }

      /* ── Skip link ── */
      .arcade-skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--p31-teal);
        color: #000;
        padding: 8px 16px;
        z-index: 1000;
        font-weight: 600;
        text-decoration: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        border-radius: 0 0 6px 0;
      }
      .arcade-skip-link:focus { top: 0; }

      /* ── Header ── */
      .arcade-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 52px;
        background: color-mix(in srgb, var(--p31-void) 95%, transparent);
        border-bottom: 2px solid var(--game-color, var(--p31-teal));
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 14px;
        z-index: 100;
        backdrop-filter: blur(10px);
      }

      /* ── Spoon gauge ── */
      .spoon-gauge {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        background: rgba(0,0,0,0.3);
        border: 1px solid var(--p31-white-8);
        border-radius: 99px;
        min-width: 130px;
        flex-shrink: 0;
      }
      .spoon-gauge-icon { font-size: 13px; line-height: 1; }
      .spoon-gauge-track {
        flex: 1;
        height: 7px;
        border-radius: 99px;
        background: var(--p31-white-6);
        overflow: hidden;
      }
      .spoon-gauge-fill {
        height: 100%;
        border-radius: 99px;
        background: var(--spoon-color, var(--p31-teal));
        transition: width 0.5s ease, background 0.5s ease;
      }
      .spoon-gauge-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: var(--p31-cloud);
        font-weight: 700;
        min-width: 30px;
        text-align: right;
      }

      /* ── Game selector drawer ── */
      .arcade-selector {
        position: fixed;
        top: 52px;
        left: 0;
        right: 0;
        background: color-mix(in srgb, var(--p31-void) 98%, transparent);
        border-bottom: 1px solid var(--p31-white-8);
        transform: translateY(-100%);
        transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
        z-index: 99;
        max-height: 62vh;
        overflow-y: auto;
      }
      .arcade-selector[data-open="true"] {
        transform: translateY(0);
      }

      /* ── Game grid ── */
      .arcade-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
        gap: 12px;
        padding: 14px;
      }

      /* ── Game card ── */
      .arcade-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 14px 10px;
        background: var(--p31-white-3);
        border: 2px solid transparent;
        border-radius: 12px;
        text-decoration: none;
        color: var(--p31-cloud);
        transition: all 0.2s;
        cursor: pointer;
        position: relative;
      }
      .arcade-card:hover {
        background: var(--p31-white-6);
        border-color: var(--card-color, var(--p31-teal));
        transform: translateY(-2px);
      }
      .arcade-card.active {
        background: var(--p31-teal-dim);
        border-color: var(--card-color, var(--p31-teal));
      }
      .arcade-card-icon { font-size: 30px; line-height: 1; }
      .arcade-card-title {
        font-size: 10px;
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .arcade-card-desc {
        font-size: 9px;
        color: var(--p31-cloud-40);
        text-align: center;
        line-height: 1.4;
      }
      .arcade-card-spoons {
        font-size: 9px;
        opacity: 0.85;
        margin-top: 2px;
      }

      /* ── Toggle ── */
      .arcade-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        background: var(--p31-white-5);
        border: 1px solid var(--p31-white-10);
        border-radius: 8px;
        color: var(--p31-cloud);
        cursor: pointer;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        transition: all 0.2s;
      }
      .arcade-toggle:hover {
        background: var(--p31-white-10);
        border-color: var(--game-color, var(--p31-teal));
      }
      .arcade-toggle[aria-expanded="true"] {
        background: var(--game-color, var(--p31-teal));
        color: #0f1115;
        border-color: var(--game-color, var(--p31-teal));
      }

      /* ── Content ── */
      .arcade-content {
        margin-top: 52px;
        min-height: calc(100vh - 52px);
        position: relative;
      }
      .arcade-content.fullscreen {
        margin-top: 0;
        min-height: 100vh;
      }

      .pixel-font {
        font-family: 'Press Start 2P', cursive;
        font-size: 10px;
        line-height: 1.6;
      }

      /* ── High score ── */
      .high-score {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 12px;
        background: rgba(0,0,0,0.3);
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
      }
      .high-score-label { color: var(--p31-cloud-50); text-transform: uppercase; font-size: 9px; }
      .high-score-value { color: var(--p31-gold); font-weight: 700; }

      /* ── A11y: screen-reader-only ── */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }

      /* ── Branding ── */
      .arcade-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--p31-cloud);
        flex-shrink: 0;
      }
      .arcade-brand-icon { font-size: 20px; }
      .arcade-brand-text { display: flex; flex-direction: column; }
      .arcade-brand-name {
        font-family: 'Press Start 2P', cursive;
        font-size: 7px;
        color: var(--game-color, var(--p31-teal));
        letter-spacing: 0.08em;
      }
      .arcade-brand-game { font-size: 12px; font-weight: 600; }

      /* ── Actions ── */
      .arcade-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
      }
      .arcade-btn {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--p31-white-5);
        border: 1px solid var(--p31-white-10);
        border-radius: 8px;
        color: var(--p31-cloud);
        cursor: pointer;
        font-size: 16px;
        transition: all 0.2s;
        text-decoration: none;
      }
      .arcade-btn:hover {
        background: var(--p31-white-10);
        border-color: var(--game-color, var(--p31-teal));
      }

      /* ── Responsive ── */
      @media (max-width: 600px) {
        .arcade-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 10px; }
        .arcade-card { padding: 10px 8px; }
        .arcade-card-icon { font-size: 22px; }
        .arcade-card-desc { display: none; }
        .arcade-card-spoons { font-size: 8px; }
        .spoon-gauge { min-width: 100px; padding: 4px 8px; }
        .spoon-gauge-value { font-size: 9px; }
        .arcade-brand-game { display: none; }
        .high-score { display: none; }
      }
    </style>
  </head>

  <body style={`--game-color: ${currentGame.color};`}>
    <a href="#game-content" class="arcade-skip-link">Skip to game</a>

    <div id="a11y-announcer-spoon" class="sr-only" aria-live="polite" aria-atomic="true" role="status"></div>
    <div id="a11y-announcer-status" class="sr-only" aria-live="polite" aria-atomic="true" role="status"></div>

    {!fullscreen && (
      <>
        <header class="arcade-header">
          <a href="/arcade/" class="arcade-brand">
            <span class="arcade-brand-icon">🎮</span>
            <div class="arcade-brand-text">
              <span class="arcade-brand-name">P31 ARCADE</span>
              <span class="arcade-brand-game">{gameTitle}</span>
            </div>
          </a>

          <!-- Spoon gauge -->
          <div
            id="spoon-gauge"
            class="spoon-gauge"
            title={`Spoons: ${initialSpoonLevel}/12`}
            aria-label={`Spoon energy: ${initialSpoonLevel} of 12`}
            style={`--spoon-color: ${initialSpoonColor};`}
          >
            <span class="spoon-gauge-icon" aria-hidden="true">🥄</span>
            <div class="spoon-gauge-track">
              <div
                class="spoon-gauge-fill"
                id="spoon-fill"
                style={`width: ${(initialSpoonLevel / 12) * 100}%; background: ${initialSpoonColor};`}
              />
            </div>
            <span class="spoon-gauge-value" id="spoon-value">{initialSpoonLevel}</span>
          </div>

          {showSelector && (
            <button
              id="arcade-selector-toggle"
              class="arcade-toggle"
              aria-label="Select game"
              aria-expanded="false"
              aria-controls="arcade-selector"
              type="button"
            >
              <span>🎯</span>
              <span>Games</span>
              <span id="game-count">{arcadeGames.length - 1}</span>
            </button>
          )}

          <div class="arcade-actions">
            <div class="high-score" id="arcade-high-score" style="display: none;">
              <span class="high-score-label">HI</span>
              <span class="high-score-value" id="high-score-value">0</span>
            </div>

            <a href="/" class="arcade-btn" aria-label="P31 Hub" title="P31 Hub">🏠</a>

            <button
              id="arcade-fullscreen"
              class="arcade-btn"
              aria-label="Toggle fullscreen"
              title="Fullscreen"
            >
              ⛶
            </button>
          </div>
        </header>

        {showSelector && (
          <nav id="arcade-selector" class="arcade-selector" data-open="false" aria-label="Game selection">
            <div class="arcade-grid">
              {arcadeGames.map(game => (
                <a
                  href={game.href}
                  class={`arcade-card ${game.id === 'hub' ? '' : 'arcade-card-' + game.id} ${game.id === gameId ? 'active' : ''}`}
                  style={`--card-color: ${game.color};`}
                  aria-current={game.id === gameId ? 'page' : undefined}
                >
                  <span class="arcade-card-icon">{game.emoji}</span>
                  <span class="arcade-card-title">{game.title}</span>
                  <span class="arcade-card-desc">{game.desc}</span>
                  <span class="arcade-card-spoons" aria-label={`Low-spoon friendly`} title={`Spoon difficulty: ${game.spoonDifficulty}/5`}>
                    {'🥄'.repeat(Math.max(1, game.spoonDifficulty))}
                  </span>
                </a>
              ))}
            </div>
          </nav>
        )}
      </>
    )}

    <main
      id="game-content"
      class={`arcade-content ${fullscreen ? 'fullscreen' : ''}`}
      role="main"
      aria-label={`${gameTitle} game`}
    >
      <SpoonSync client:load />
      <slot />
    </main>

    <script is:inline>
      (function() {
        'use strict';
        const SPOON_COLORS = {
          0:'var(--p31-coral)',1:'var(--p31-coral)',2:'var(--p31-butter)',3:'var(--p31-butter)',
          4:'var(--p31-cyan)',5:'var(--p31-cyan)',6:'var(--p31-cyan)',7:'var(--p31-cyan)',
          8:'var(--p31-phosphorus)',9:'var(--p31-phosphorus)',10:'var(--p31-phosphorus)',11:'var(--p31-phosphorus)',12:'var(--p31-phosphorus)'
        };

        // Game selector toggle
        const toggle = document.getElementById('arcade-selector-toggle');
        const selector = document.getElementById('arcade-selector');
        const gameCount = document.getElementById('game-count');

        toggle?.addEventListener('click', () => {
          const isOpen = selector?.getAttribute('data-open') === 'true';
          selector?.setAttribute('data-open', String(!isOpen));
          toggle.setAttribute('aria-expanded', String(!isOpen));
        });

        selector?.querySelectorAll('.arcade-card').forEach(card => {
          card.addEventListener('click', () => {
            selector.setAttribute('data-open', 'false');
            toggle?.setAttribute('aria-expanded', 'false');
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            selector?.setAttribute('data-open', 'false');
            toggle?.setAttribute('aria-expanded', 'false');
          }
        });

        // Fullscreen toggle
        const fsBtn = document.getElementById('arcade-fullscreen');
        fsBtn?.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });

        // Spoon gauge — live update from global event bus
        const spoonFill = document.getElementById('spoon-fill');
        const spoonValue = document.getElementById('spoon-value');
        const spoonGauge = document.getElementById('spoon-gauge');

        function announceA11y(elId, msg) {
          if (!msg) return;
          const el = document.getElementById(elId);
          if (!el) return;
          el.textContent = '';
          requestAnimationFrame(() => { el.textContent = msg; });
        }

        function updateSpoonGauge(level) {
          const lvl = Math.max(0, Math.min(12, Number(level) || 4));
          const pct = (lvl / 12) * 100;
          const color = SPOON_COLORS[lvl] || 'var(--p31-cyan)';
          if (spoonFill) {
            spoonFill.style.width = pct + '%';
            spoonFill.style.background = color;
          }
          if (spoonValue) {
            spoonValue.textContent = lvl;
            spoonValue.style.color = color;
          }
          if (spoonGauge) {
            spoonGauge.style.setProperty('--spoon-color', color);
            spoonGauge.title = 'Spoons: ' + lvl + '/12';
            spoonGauge.setAttribute('aria-label', 'Spoon energy: ' + lvl + ' of 12');
          }
          announceA11y('a11y-announcer-spoon', 'Spoon energy: ' + lvl + ' of 12');
        }

        window.addEventListener('p31:spoon:changed', (e) => {
          if (e.detail?.level !== undefined) {
            updateSpoonGauge(e.detail.level);
          }
        });

        // High score from games
        window.addEventListener('p31:arcade-highscore', (e) => {
          const scoreEl = document.getElementById('high-score-value');
          const container = document.getElementById('arcade-high-score');
          if (scoreEl && e.detail?.score !== undefined) {
            scoreEl.textContent = Number(e.detail.score).toLocaleString();
            container.style.display = 'flex';
          }
        });

        window.p31SetHighScore = function(score) {
          window.dispatchEvent(new CustomEvent('p31:arcade-highscore', { detail: { score } }));
        };

        window.p31ArcadeHealth = function() {
          return {
            game: document.documentElement.getAttribute('data-arcade-game'),
            fullscreen: !!document.fullscreenElement,
            selector: selector?.getAttribute('data-open') === 'true',
            spoonLevel: spoonValue ? spoonValue.textContent : '?',
          };
        };
      })();
    </script>
  </body>
</html>
