---
import { SITE_DATA } from '../data/site-data';
---

<main class="animate-[fadeIn_0.4s_ease-out]">
  {/* HERO SECTION */}
  <section class="relative max-w-7xl mx-auto px-6 py-20 md:py-32 flex flex-col-reverse md:flex-row items-center gap-16">
    <div class="flex-1 space-y-8 z-10">
      <div class="inline-block bg-quantum-violet/20 text-quantum-violet font-bold text-xs px-4 py-1.5 rounded-full border border-quantum-violet/40">
        Evidence-Based Assistive Technology
      </div>
      <h1 class="text-5xl md:text-7xl font-heading font-black leading-[1.1] text-white">
        Technology that moves at the <span class="text-quantum-cyan">speed of your child's brain.</span>
      </h1>
      <p class="text-lg md:text-xl text-cloud/70 max-w-xl">
        <strong class="text-quantum-cyan">Bottom Line Up Front:</strong> We build free, open-source tools for neurodivergent families to manage energy, facilitate co-parenting, and foster connection without sensory overload.
      </p>
      <div class="flex flex-col sm:flex-row flex-wrap gap-4 pt-4">
        <a href="/products" class="bg-quantum-violet hover:bg-quantum-violet/80 text-white font-bold text-lg py-4 px-8 rounded-2xl shadow-lg transition-transform hover:-translate-y-1 text-center no-underline">
          Find Tools for My Family
        </a>
        <a href="https://p31ca.org/" target="_blank" rel="noopener noreferrer" class="bg-quantum-cyan/20 hover:bg-quantum-cyan/30 text-quantum-cyan font-bold text-lg py-4 px-8 rounded-2xl shadow-md transition-transform hover:-translate-y-1 text-center no-underline border-2 border-quantum-cyan/50">
          Technical Hub ↗
        </a>
        <a href="https://discord.gg/uYW5rTCuZ" target="_blank" rel="noopener noreferrer" class="bg-surface2 hover:bg-surface text-cloud font-bold text-lg py-4 px-8 rounded-2xl border-2 border-cloud/10 transition-colors text-center no-underline">
          Join Discord
        </a>
      </div>
    </div>

    {/* Quantum Illustration */}
    <div class="flex-1 relative w-full h-[400px] flex items-center justify-center">
      <div class="absolute w-[80%] h-[80%] bg-quantum-cyan/20 organic-blob mix-blend-screen"></div>
      <div class="absolute w-[70%] h-[70%] bg-quantum-violet/30 organic-blob mix-blend-screen" style="animation-delay: -2s"></div>
      <div class="absolute w-[60%] h-[60%] bg-quantum-gold/20 organic-blob mix-blend-screen" style="animation-delay: -4s"></div>

      <div class="relative z-10 glass-box p-8 rounded-3xl shadow-xl border border-quantum-cyan/20 transform rotate-[-3deg] max-w-sm">
        <div class="w-16 h-16 bg-gradient-to-br from-quantum-cyan via-quantum-violet to-quantum-gold rounded-full mx-auto mb-6 relative overflow-hidden">
          <div class="w-4 h-4 bg-void rounded-full absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 shadow-inner"></div>
          <div class="absolute inset-0 border-2 border-quantum-cyan/60 rounded-full animate-orbit-slow"></div>
          <div class="absolute inset-1 border-2 border-quantum-violet/60 rounded-full animate-orbit-fast" style="animation-delay: 0.5s"></div>
          <div class="absolute inset-2 border-2 border-quantum-gold/60 rounded-full animate-orbit-medium" style="animation-delay: 1s"></div>
          <div class="absolute top-0 left-1/2 w-3 h-3 bg-quantum-cyan rounded-full transform -translate-x-1/2 -translate-y-1/2 animate-orbit-slow"></div>
          <div class="absolute bottom-0 right-1/2 w-3 h-3 bg-quantum-violet rounded-full transform translate-x-1/2 translate-y-1/2 animate-orbit-fast" style="animation-delay: 0.5s"></div>
          <div class="absolute left-0 top-1/2 w-3 h-3 bg-quantum-gold rounded-full transform -translate-x-1/2 -translate-y-1/2 animate-orbit-medium" style="animation-delay: 1s"></div>
        </div>
        <h3 class="font-heading font-bold text-xl text-center mb-2 text-white">BONDING App</h3>
        <p class="text-sm text-cloud/70 text-center mb-4">Build molecules with your kids across the country in real-time.</p>
        <div class="h-3 w-full bg-surface2 rounded-full overflow-hidden">
          <div class="h-full bg-quantum-violet w-3/4"></div>
        </div>
      </div>
    </div>
  </section>

  {/* METRICS BAR */}
  <section class="bg-surface text-white py-12">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-white/10">
      <div class="text-center">
        <div class="text-4xl font-black font-heading text-quantum-gold mb-2">{SITE_DATA.metrics.bondingTestCount}</div>
        <div class="text-sm font-medium text-cloud/80 uppercase tracking-widest">BONDING Tests</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-black font-heading text-quantum-cyan mb-2">100%</div>
        <div class="text-sm font-medium text-cloud/80 uppercase tracking-widest">Open Source</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-black font-heading text-quantum-violet mb-2">{SITE_DATA.metrics.phosSurfaces}</div>
        <div class="text-sm font-medium text-cloud/80 uppercase tracking-widest">Hub + Suite Routes</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-black font-heading text-quantum-green mb-2">$0</div>
        <div class="text-sm font-medium text-cloud/80 uppercase tracking-widest">Cost to Families</div>
      </div>
    </div>
  </section>

  {/* FAMILY NEEDS GRID */}
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-heading font-black text-white mb-4">What does your family need today?</h2>
      <p class="text-lg text-cloud/60 max-w-2xl mx-auto">We organize our tools by the actual challenges neurodivergent families face, not by clinical terminology.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <a href="https://bonding.p31ca.org" target="_blank" rel="noopener noreferrer" class="glass-box p-8 rounded-3xl border-t-4 border-t-quantum-cyan hover:shadow-xl transition-shadow cursor-pointer group no-underline block">
        <div class="w-14 h-14 bg-quantum-cyan/10 rounded-2xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">&#x269B;&#xFE0F;</div>
        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Remote Connection</h3>
        <p class="text-cloud/70 mb-6 text-sm">Tools for co-parents and families separated by distance. Build meaningful memories when you can't be in the same room.</p>
        <div class="text-quantum-cyan font-bold flex items-center gap-2">Launch BONDING <span class="text-xl">&#x2192;</span></div>
      </a>

      <a href="https://p31ca.org/ede-about.html" target="_blank" rel="noopener noreferrer" class="glass-box p-8 rounded-3xl border-t-4 border-t-quantum-violet hover:shadow-xl transition-shadow cursor-pointer group no-underline block">
        <div class="w-14 h-14 bg-quantum-violet/10 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">&#x2B21;</div>
        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Cognitive Prosthetics</h3>
        <p class="text-cloud/70 mb-6 text-sm">The EDE: a browser-native IDE with Jitterbug Compiler, spoon tracking, Samson's Law entropy linter, and 4-tier progressive disclosure. Zero npm. Works offline.</p>
        <div class="text-quantum-violet font-bold flex items-center gap-2">Explore EDE <span class="text-xl">&#x2192;</span></div>
      </a>

      <a href="https://p31ca.org/buffer-about.html" target="_blank" rel="noopener noreferrer" class="glass-box p-8 rounded-3xl border-t-4 border-t-quantum-gold hover:shadow-xl transition-shadow cursor-pointer group no-underline block">
        <div class="w-14 h-14 bg-quantum-gold/20 rounded-2xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform">&#x1F6E1;&#xFE0F;</div>
        <h3 class="font-heading font-bold text-2xl mb-3 text-white">Communication Shields</h3>
        <p class="text-cloud/70 mb-6 text-sm">AI-powered tools that strip emotional hostility from high-conflict emails and texts. The Fawn Guard Buffer detects passive-aggression, scores voltage, activates protective protocols.</p>
        <div class="text-quantum-gold font-bold flex items-center gap-2">See The Buffer <span class="text-xl">&#x2192;</span></div>
      </a>
    </div>
  </section>

  {/* ONE ORG, THREE DOORS — vision bridge (see docs/SITE_MAP_AND_OWNERSHIP.md) */}
  <section class="bg-surface text-cloud py-16 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-block bg-quantum-cyan/20 text-quantum-cyan font-bold text-xs px-4 py-1.5 rounded-full border border-quantum-cyan/40 mb-4">
          One organization, three doors
        </div>
        <h2 class="text-3xl md:text-4xl font-heading font-black text-white mb-3">Same mission — different entry points</h2>
        <p class="text-cloud/70 max-w-2xl mx-auto">
          Trust and fundraising live here. Tools, repos, and fleet status live on the technical hub. Authoritative mesh state and agents run on Cloudflare Workers (linked from the hub, not duplicated on static pages).
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="rounded-2xl bg-surface/5 border border-white/10 p-6">
          <div class="text-quantum-gold font-heading font-bold text-lg mb-2">Nonprofit portal</div>
          <p class="text-sm text-cloud/75 mb-4">Mission, donate, research narrative, transparency — you are here.</p>
          <a href="/donate" class="text-quantum-violet font-bold text-sm hover:text-quantum-violet/80 no-underline">Donate →</a>
        </div>
        <div class="rounded-2xl bg-quantum-cyan/10 border border-quantum-cyan/30 p-6">
          <div class="text-quantum-cyan font-heading font-bold text-lg mb-2">Technical hub</div>
          <p class="text-sm text-cloud/75 mb-4">Hub cards, static apps, Production Suite links, command-center fleet strip.</p>
          <a href="https://p31ca.org/" target="_blank" rel="noopener noreferrer" class="text-white font-bold text-sm hover:underline no-underline">p31ca.org ↗</a>
        </div>
        <div class="rounded-2xl bg-surface/5 border border-white/10 p-6">
          <div class="text-cloud font-heading font-bold text-lg mb-2">Edge runtime</div>
          <p class="text-sm text-cloud/75 mb-4">K₄ cage, agent hub, Carrie, Fawn API — Wrangler deploys; KV is source of truth for mesh.</p>
          <a href="https://github.com/p31labs/andromeda/blob/main/docs/SITE_MAP_AND_OWNERSHIP.md" target="_blank" rel="noopener noreferrer" class="text-quantum-cyan font-bold text-sm hover:text-quantum-cyan/80 no-underline">Site map &amp; ownership ↗</a>
        </div>
      </div>
    </div>
  </section>

  {/* RESEARCH / ZENODO DOIs */}
  <section class="bg-gradient-to-br from-surface via-surface2 to-surface py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-block bg-quantum-cyan/20 text-quantum-cyan font-bold text-sm px-4 py-1.5 rounded-full border border-quantum-cyan/30 mb-4">
          Peer-Reviewed Publications
        </div>
        <h2 class="text-3xl md:text-4xl font-heading font-black text-white mb-4">Published Research</h2>
        <p class="text-white/60 max-w-2xl mx-auto">
          Mathematical frameworks grounding the P31 ecosystem. Both publications open-access on Zenodo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <div class="bg-surface/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-quantum-cyan/30 transition-colors">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-quantum-cyan text-void text-xs font-bold px-3 py-1 rounded-full">DOI</span>
            <span class="text-white/40 text-xs font-mono">10.5281/zenodo.19004485</span>
          </div>
          <h3 class="text-xl font-heading font-bold text-white mb-3">Tetrahedron Protocol (K4)</h3>
          <p class="text-white/60 text-sm mb-4 leading-relaxed">
            Geometric proof that decentralized K4 topology is inherently more stable than centralized systems. 280+ views, 240+ downloads. Includes open-source implementation.
          </p>
          <a href="https://doi.org/10.5281/zenodo.19004485" target="_blank" rel="noopener noreferrer" class="text-quantum-cyan text-sm font-bold hover:text-quantum-cyan/80">
            Read on Zenodo &#x2192;
          </a>
        </div>

        <div class="bg-surface/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:border-quantum-cyan/30 transition-colors">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-quantum-cyan text-void text-xs font-bold px-3 py-1 rounded-full">DOI</span>
            <span class="text-white/40 text-xs font-mono">10.5281/zenodo.19411363</span>
          </div>
          <h3 class="text-xl font-heading font-bold text-white mb-3">Genesis Whitepaper v1.1</h3>
          <p class="text-white/60 text-sm mb-4 leading-relaxed">
            SIC-POVM measurement framework, EDE architecture, Q Distribution spoon tracking, Samson's Law entropy formalization. Six implemented systems.
          </p>
          <a href="https://doi.org/10.5281/zenodo.19411363" target="_blank" rel="noopener noreferrer" class="text-quantum-cyan text-sm font-bold hover:text-quantum-cyan/80">
            Read on Zenodo &#x2192;
          </a>
        </div>
      </div>

      <div class="text-center">
        <a href="/research" class="inline-flex items-center gap-2 bg-quantum-cyan hover:bg-quantum-cyan/80 text-void font-bold py-3 px-6 rounded-xl transition-colors no-underline">
          All Publications & White Papers &#x2192;
        </a>
      </div>
    </div>
  </section>

  {/* COMMUNITY */}
  <section class="bg-surface2 py-20 border-y border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-heading font-black text-white mb-4">Join the Community</h2>
      <p class="text-cloud/70 max-w-xl mx-auto mb-10">
        Discord server for neurodivergent builders, parents, and researchers. Ko-fi for those who want to fund the work directly.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://discord.gg/uYW5rTCuZ" target="_blank" rel="noopener noreferrer" class="bg-quantum-violet hover:bg-quantum-violet/80 text-white font-bold py-3 px-8 rounded-xl transition-colors no-underline">
          Join Discord
        </a>
        <a href="https://ko-fi.com/trimtab69420" target="_blank" rel="noopener noreferrer" class="bg-quantum-gold hover:bg-quantum-gold/80 text-void font-bold py-3 px-8 rounded-xl transition-colors no-underline">
          Support on Ko-fi
        </a>
        <a href="https://github.com/p31labs" target="_blank" rel="noopener noreferrer" class="bg-surface hover:bg-surface2 text-cloud font-bold py-3 px-8 rounded-xl transition-colors no-underline border border-cloud/10">
          GitHub
        </a>
      </div>
    </div>
  </section>

  {/* GLASS BOX ETHOS */}
  <section class="bg-void/50 py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-heading font-black text-white mb-8">The Glass Box Ethos</h2>
      <p class="text-xl text-cloud/80 leading-relaxed mb-10">
        Modern assistive tech is often locked behind expensive medical paywalls and proprietary black boxes. <strong class="text-quantum-cyan">We believe accessibility is a human right.</strong> P31 Labs operates with absolute transparency. You can see our code, our bank accounts, and our physical hardware blueprints.
      </p>
      <a href="/transparency" class="inline-block bg-surface2 text-quantum-cyan font-bold py-3 px-8 rounded-xl shadow-md hover:bg-surface/10 transition-colors no-underline border border-quantum-cyan/20">
        Open the Glass Box
      </a>
    </div>
  </section>

  {/* DONATE CTA */}
  <section class="bg-gradient-to-br from-quantum-violet via-surface to-quantum-cyan py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="text-quantum-gold font-bold tracking-widest uppercase text-sm mb-4">Support P31 Labs</div>
      <h2 class="text-3xl md:text-4xl font-heading font-black text-white mb-6">Every atom placed is a connection.</h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-10">
        Your donation directly funds free, open-source assistive technology for neurodivergent families. No middleman. No paywall. Just tools that work.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="bg-quantum-violet hover:bg-quantum-violet/80 text-white font-bold text-lg py-4 px-10 rounded-2xl shadow-lg transition-transform hover:-translate-y-1 no-underline">
          Donate via PayPal
        </a>
        <a href="https://ko-fi.com/trimtab69420" target="_blank" rel="noopener noreferrer" class="bg-surface/10 hover:bg-surface/20 text-white font-bold text-lg py-4 px-10 rounded-2xl border-2 border-white/20 transition-colors no-underline">
          Ko-fi (0% fee)
        </a>
      </div>
    </div>
  </section>
</main>



