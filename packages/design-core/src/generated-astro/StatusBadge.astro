---
// @file StatusBadge — Status indicator badge.
// Auto-generated from components.yml.

interface Props {
  status?: 'live' | 'beta' | 'research';
  class?: string;
}

const { status = 'live', class: className = '' } = Astro.props;

const STATUS_CONFIG = {
  live: 'bg-green-500/20 text-green-400 border-green-500/30',
  beta: 'bg-gold/20 text-gold border-gold/30',
  research: 'bg-violet/20 text-violet border-violet/30',
};
---

<span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${STATUS_CONFIG[status]} ${className}`}>
  <slot />
</span>
