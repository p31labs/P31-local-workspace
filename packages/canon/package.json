{
  "name": "@p31/canon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "P31 CANON — tokens + contracts + CSS, fresh architecture. Generated exports only; no hand-maintained maps, no vendored theater.",
  "sideEffects": false,
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:exports": "node scripts/generate-exports.mjs",
    "gen:registry": "node scripts/gen-registry.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "verify:parity": "node scripts/verify-token-parity.mjs",
    "verify:loom-seal": "node scripts/check-loom-seal.mjs",
    "test:loom": "node scripts/check-loom-seal.mjs && node scripts/test-loom-replay.mjs && node scripts/test-loom-gate.mjs && node scripts/test-loom-determinism.mjs && node scripts/test-loom-convergence.mjs && node scripts/test-loom-commit.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run gen:tokens && npm run validate:contracts && npm run build:css && npm run gen:registry && npm run validate:registry && npm run gen:exports"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/button.contract": "./src/contracts/button.contract.ts",
    "./contracts/schema": "./src/contracts/schema.ts",
    "./css/a2ui-datacard.css": "./dist/css/a2ui-datacard.css",
    "./css/all.css": "./dist/css/all.css",
    "./css/ambient.css": "./dist/css/ambient.css",
    "./css/base.css": "./dist/css/base.css",
    "./css/container.css": "./dist/css/container.css",
    "./css/glass.css": "./dist/css/glass.css",
    "./css/layout.css": "./dist/css/layout.css",
    "./css/link-glow.css": "./dist/css/link-glow.css",
    "./css/motion.css": "./dist/css/motion.css",
    "./css/quantum.css": "./dist/css/quantum.css",
    "./css/recipes.css": "./dist/css/recipes.css",
    "./css/size-class.css": "./dist/css/size-class.css",
    "./css/typography.css": "./dist/css/typography.css",
    "./loom/commit": "./src/loom/commit.ts",
    "./loom/events": "./src/loom/events.ts",
    "./loom/gate": "./src/loom/gate.ts",
    "./loom/jsonl": "./src/loom/jsonl.ts",
    "./registry.json": "./registry.json",
    "./theming": "./src/theming/index.ts",
    "./theming/theme-css": "./src/theming/theme-css.ts",
    "./theming/theme-store": "./src/theming/theme-store.ts",
    "./tokens.css": "./dist/tokens.css"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
