{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types", "@types/web-bluetooth"],
    "lib": ["DOM", "ES2020"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@p31/shared": ["../packages/shared/src"],
      "@p31/shared/*": ["../packages/shared/src/*"],
      "@p31/node-zero": ["../packages/node-zero/src"],
      "@p31/node-zero/*": ["../packages/node-zero/src/*"],
      "@p31/love-ledger": ["../packages/love-ledger/src"],
      "@p31/love-ledger/*": ["../packages/love-ledger/src/*"],
      "@p31/game-engine": ["../packages/game-engine/src"],
      "@p31/game-engine/*": ["../packages/game-engine/src/*"],
      "@p31/sovereign": ["../packages/sovereign/src"],
      "@p31/sovereign/*": ["../packages/sovereign/src/*"],
      "@p31/quantum-core": ["../../packages/quantum-core/src"],
      "@p31/quantum-core/*": ["../../packages/quantum-core/src/*"],
      "@p31/design-core": ["../../packages/design-core/src"],
      "@p31/design-core/*": ["../../packages/design-core/src/*"],
      "@p31/tetra": ["src/lib/tetra"],
      "@p31/tetra/*": ["src/lib/tetra/*"]
    }
  },
  "include": ["src", "src/types/**/*.d.ts"],
  "exclude": ["src/services/webgpu/**/*", "src/__tests__/**/*"]
}
